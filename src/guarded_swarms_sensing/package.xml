<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>guarded_swarms_sensing</name>
  <version>0.0.0</version>
  <description>Consultant agents: the four sensing modalities of the coastal surveillance scenario, synthesising observation tokens from target ground truth.</description>
  <maintainer email="daurizio.lc@gmail.com">Luca D'Aurizio</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>guarded_swarms_msgs</depend>
  <depend>std_msgs</depend>
  <!-- px4_msgs: only the EO agent needs it, to read the carrier UAV's
       position (its camera coverage moves with the drone). -->
  <depend>px4_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
