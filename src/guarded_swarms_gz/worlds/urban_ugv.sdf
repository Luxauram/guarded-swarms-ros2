<?xml version="1.0" encoding="UTF-8"?>
<!--
  Guarded Swarms - Urban UGV World (R2 scenario)

  Scenario: UGV (rover with frontal lidar) patrols an urban street.
  Agents C+D submit tokens → coordinator approves → UGV executes command.
  When the lidar detects a vehicle or wall within 1.5m, the analog safety
  board vetoes the actuator command independently of the digital layer.
  This is the exact R2 case from the Guarded Swarms paper.

  World layout (top view, each unit = 1m):
    - Ground: asphalt-textured plane with higher friction (rover physics)
    - Street corridor: two parallel building rows along Y axis
    - Left building row:  at X = -8  (wall face at X = -3)
    - Right building row: at X = +8  (wall face at X = +3)
    - Abandoned vehicle obstacle: at (0, 10, 0.5) ← triggers proximity veto
    - Concrete barrier:           at (1, 6, 0.5)
    - UGV spawn point: (0, 0, 0.1) → moves along street (Y direction)
-->
<sdf version="1.9">
  <world name="urban_ugv">

    <!-- ================================================================ -->
    <!-- Physics: same as PX4 rover world (500Hz for ground contact) -->
    <!-- ================================================================ -->
    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <!-- ================================================================ -->
    <!-- Scene: urban street lighting -->
    <!-- ================================================================ -->
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.5 0.6 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sun -->
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <!-- ================================================================ -->
    <!-- Ground plane: asphalt with higher friction for rover -->
    <!-- ================================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>2</mu>
                <mu2>2</mu2>
              </ode>
            </friction>
            <bounce/>
            <contact>
              <collide_bitmask>65535</collide_bitmask>
              <ode>
                <min_depth>0.005</min_depth>
                <kp>1e8</kp>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.28 0.28 0.28 1</ambient>
            <diffuse>0.32 0.32 0.32 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <mass>1</mass>
          <inertia><ixx>1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1</iyy><iyz>0</iyz><izz>1</izz></inertia>
        </inertial>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- Street corridor: left building row -->
    <!-- ================================================================ -->
    <model name="building_left_a">
      <static>true</static>
      <pose>-10 5 6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 15 12</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 15 12</size></box></geometry>
          <material>
            <ambient>0.6 0.55 0.5 1</ambient>
            <diffuse>0.65 0.6 0.55 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="building_left_b">
      <static>true</static>
      <pose>-10 25 5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 15 10</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 15 10</size></box></geometry>
          <material>
            <ambient>0.55 0.6 0.55 1</ambient>
            <diffuse>0.6 0.65 0.6 1</diffuse>
            <specular>0.1 0.15 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Street corridor: right building row -->
    <model name="building_right_a">
      <static>true</static>
      <pose>10 5 7 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 15 14</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 15 14</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.65 0.65 0.7 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="building_right_b">
      <static>true</static>
      <pose>10 25 4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 15 8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 15 8</size></box></geometry>
          <material>
            <ambient>0.65 0.55 0.5 1</ambient>
            <diffuse>0.7 0.6 0.55 1</diffuse>
            <specular>0.15 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- Obstacle: abandoned vehicle in street                            -->
    <!-- UGV approaches from Y=0, vehicle at Y=10 → proximity veto       -->
    <!-- This is the R2 case: token approved, analog layer BLOCKS command -->
    <!-- ================================================================ -->
    <model name="obstacle_vehicle">
      <static>true</static>
      <pose>0 10 0.75 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 4.5 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 4.5 1.5</size></box></geometry>
          <material>
            <ambient>0.2 0.25 0.35 1</ambient>
            <diffuse>0.25 0.3 0.4 1</diffuse>
            <specular>0.3 0.3 0.4 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Concrete barrier: secondary obstacle -->
    <model name="obstacle_barrier">
      <static>true</static>
      <pose>2 6 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 2.5 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 2.5 0.8</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Street end wall: closes the corridor -->
    <model name="street_end_wall">
      <static>true</static>
      <pose>0 35 3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 0.5 6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 0.5 6</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- Spherical coordinates (same origin as PX4 default world) -->
    <!-- ================================================================ -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

  </world>
</sdf>
