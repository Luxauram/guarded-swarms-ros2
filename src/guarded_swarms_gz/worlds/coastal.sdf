    <!-- ============ UAV launch pads, clear of the shore road so the rover never crosses one ============ -->
    <model name="flight_ops">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <model name="uav_pad_0">
        <static>true</static>
        <pose>-24 -24 -0.01 0 0 0</pose>
        <link name="link">
          <visual name="visual">
            <cast_shadows>false</cast_shadows>
            <geometry><box><size>14 14 0.1</size></box></geometry>
            <material>
              <ambient>0.18 0.18 0.20 1</ambient>
              <diffuse>0.20 0.20 0.22 1</diffuse>
              <specular>0.12 0.12 0.12 1</specular>
            </material>
          </visual>
        </link>
      </model>

      <model name="uav_pad_0_marking">
        <static>true</static>
        <pose>-24 -24 0.05 0 0 0</pose>
        <link name="link">
          <visual name="visual">
            <cast_shadows>false</cast_shadows>
            <geometry><box><size>9 0.8 0.02</size></box></geometry>
            <material>
              <ambient>0.90 0.90 0.90 1</ambient>
              <diffuse>1.00 1.00 1.00 1</diffuse>
              <specular>0.12 0.12 0.12 1</specular>
            </material>
          </visual>
        </link>
      </model>

      <model name="uav_pad_1">
        <static>true</static>
        <pose>24 -24 -0.01 0 0 0</pose>
        <link name="link">
          <visual name="visual">
            <cast_shadows>false</cast_shadows>
            <geometry><box><size>14 14 0.1</size></box></geometry>
            <material>
              <ambient>0.18 0.18 0.20 1</ambient>
              <diffuse>0.20 0.20 0.22 1</diffuse>
              <specular>0.12 0.12 0.12 1</specular>
            </material>
          </visual>
        </link>
      </model>

      <model name="uav_pad_1_marking">
        <static>true</static>
        <pose>24 -24 0.05 0 0 0</pose>
        <link name="link">
          <visual name="visual">
            <cast_shadows>false</cast_shadows>
            <geometry><box><size>9 0.8 0.02</size></box></geometry>
            <material>
              <ambient>0.90 0.90 0.90 1</ambient>
              <diffuse>1.00 1.00 1.00 1</diffuse>
              <specular>0.12 0.12 0.12 1</specular>
            </material>
          </visual>
        </link>
      </model>

    </model>

    <!-- ============ Hostile aerial target ============
         Driven kinematically by intruder_node, so the trajectory is
         identical on every run. At world level: see above.
         ============================================================== -->
    <include>
      <uri>model://intruder</uri>
      <name>intruder</name>
      <pose>0 180 15 0 0 0</pose>
    </include>

    <!-- ============ Shore obstacles on the UGV patrol line: the digital layer keeps issuing the patrol command while the analogue board vetoes ============ -->
    <model name="obstacles">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <model name="beached_container">
        <static>true</static>
        <pose>62 -14 1.3 0 0 0.12</pose>
        <link name="link">
          <collision name="collision">
            <geometry><box><size>7.0 2.6 2.6</size></box></geometry>
          </collision>
          <visual name="visual">
            <cast_shadows>true</cast_shadows>
            <geometry><box><size>7.0 2.6 2.6</size></box></geometry>
            <material>
              <ambient>0.34 0.30 0.22 1</ambient>
              <diffuse>0.38 0.34 0.25 1</diffuse>
              <specular>0.12 0.12 0.12 1</specular>
            </material>
          </visual>
        </link>
      </model>

      <model name="shore_rocks">
        <static>true</static>
        <pose>-78 -14 0.8 0 0 0</pose>
        <link name="link">
          <collision name="collision">
            <geometry><box><size>4.5 3.0 1.6</size></box></geometry>
          </collision>
          <visual name="visual">
            <cast_shadows>true</cast_shadows>
            <geometry><box><size>4.5 3.0 1.6</size></box></geometry>
            <material>
              <ambient>0.38 0.36 0.34 1</ambient>
              <diffuse>0.43 0.40 0.38 1</diffuse>
              <specular>0.12 0.12 0.12 1</specular>
            </material>
          </visual>
        </link>
      </model>

      <model name="road_barrier">
        <static>true</static>
        <pose>-8 -14 0.5 0 0 0</pose>
        <link name="link">
          <collision name="collision">
            <geometry><box><size>3.0 1.2 1.0</size></box></geometry>
          </collision>
          <visual name="visual">
            <cast_shadows>true</cast_shadows>
            <geometry><box><size>3.0 1.2 1.0</size></box></geometry>
            <material>
              <ambient>0.72 0.70 0.68 1</ambient>
              <diffuse>0.81 0.78 0.76 1</diffuse>
              <specular>0.12 0.12 0.12 1</specular>
            </material>
          </visual>
        </link>
      </model>

    </model>

    <!-- Same origin as the PX4 default world, so GPS-derived state
         matches the other scenarios. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
