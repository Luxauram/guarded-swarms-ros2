<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>guarded_swarms_gz</name>
  <version>0.1.0</version>
  <description>
    Gazebo Harmonic simulation assets for Guarded Swarms: the coastal
    surveillance world and the UAV/UGV/intruder models it spawns.
  </description>
  <maintainer email="daurizio.lc@gmail.com">Luca D'Aurizio</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>