<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>guarded_swarms_bringup</name>
  <version>0.0.0</version>
  <description>
    Launch files for the Guarded Swarms architecture: bring up the coastal
    scenario, the TB-CSPN coordination layer, the analog safety board and the
    PX4 bridges. The coastal and mock pipelines are the live entry points.
  </description>
  <maintainer email="daurizio.lc@gmail.com">Luca D'Aurizio</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>guarded_swarms_safety</exec_depend>
  <exec_depend>guarded_swarms_control</exec_depend>
  <exec_depend>guarded_swarms_msgs</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
