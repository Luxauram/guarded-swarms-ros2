# ==============================================================================
# Guarded Swarms - Environment Configuration
# ==============================================================================
#
# Copy this file to .env before launching:
#   cp docker/.env.example docker/.env
#
# SUPPORTED PLATFORM: Ubuntu 22.04 only.
# See README.md for the full platform notice.
#
# ==============================================================================

# ==============================================================================
# DISPLAY - X11 Forwarding (Gazebo GUI, RQT, Tkinter dashboard)
# ==============================================================================
#
# Ubuntu (native / dual boot):
#   DISPLAY=:0
#
#   Before launching GUI apps, run once in your terminal:
#     xhost +local:docker
#
#   To make this permanent, add to ~/.bashrc:
#     xhost +local:docker > /dev/null 2>&1
#
# Note: Windows (WSL2) and macOS are not supported platforms for this project.
# Gazebo will not render correctly and lidar sensors will not publish data.
# See README.md for details.
#
DISPLAY=:0
# DISPLAY=host.docker.internal:0.0   ??????????????????????????????????

# ==============================================================================
# DASHBOARD_PORT - Web Dashboard Port
# ==============================================================================
#
# Port exposed on the host for the web dashboard.
# Change this only if port 8765 is already in use on your machine.
#
# Access the dashboard at: http://localhost:<DASHBOARD_PORT>
#
DASHBOARD_PORT=8765

