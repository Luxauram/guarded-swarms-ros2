# ==============================================================================
# Guarded Swarms - Environment Configuration
# ==============================================================================

# ==============================================================================
# DISPLAY - X11 Forwarding
# ==============================================================================
#
# Required for GUI applications (Gazebo, RQT, Tkinter dashboard).
#
# Windows (VcXsrv):
#   DISPLAY=host.docker.internal:0.0
#   Make sure VcXsrv is running with "Disable access control" enabled.
#
# Linux:
#   DISPLAY=:0
#   Run 'xhost +local:docker' before launching GUI apps.
#
# macOS (XQuartz):
#   DISPLAY=<your-mac-ip>:0
#   Find your IP with: ipconfig getifaddr en0
#   Run 'xhost +' before launching GUI apps.
#   Enable "Allow connections from network clients" in XQuartz Preferences.
#
DISPLAY=host.docker.internal:0.0


# ==============================================================================
# DASHBOARD_PORT - Web Dashboard Port
# ==============================================================================
#
# Port exposed on the host for the web dashboard.
# Change this if port 8765 is already in use on your machine.
#
# Access the dashboard at: http://localhost:<DASHBOARD_PORT>
#
DASHBOARD_PORT=8765
