# ==============================================================================
# Complete User Guide
# ==============================================================================

show-guide:
	@echo ""
	@echo "======================================="
	@echo "  Guarded Swarms - Complete User Guide"
	@echo "======================================="
	@echo ""
	@echo "======================================="
	@echo "  1. REQUIREMENTS"
	@echo "======================================="
	@echo ""
	@echo "  - Docker Desktop (running)"
	@echo "  - X Server for GUI (optional):"
	@echo "      Windows: VcXsrv with 'Disable access control'"
	@echo "      Linux:   xhost +local:docker"
	@echo "      macOS:   XQuartz"
	@echo ""
	@echo "======================================="
	@echo "  2. INITIAL SETUP (First Time Only)"
	@echo "======================================="
	@echo ""
	@echo "  Automated:"
	@echo "    $$ make setup-all"
	@echo ""
	@echo "  Manual steps:"
	@echo "    $$ make setup-docker      # Build environment"
	@echo "    $$ make setup-workspace   # Compile ROS2 packages"
	@echo "    $$ make setup-px4         # Setup PX4 simulator"
	@echo "    $$ make setup-rover       # Install UGV assets (optional)"
	@echo ""
	@echo "======================================="
	@echo "  3. AVAILABLE DEMOS"
	@echo "======================================="
	@echo ""
	@echo "================================================================"
	@echo "  A) Token Coordination  (no PX4, no safety layer)"
	@echo "================================================================"
	@echo ""
	@echo "  What happens:"
	@echo "    4 autonomous agents continuously request spatial zones."
	@echo "    The coordinator validates requests, resolves conflicts, and"
	@echo "    issues signed AuthTokens to approved agents. Rejected agents"
	@echo "    are blocked until the zone is free. You can observe the"
	@echo "    arbitration logic (FCFS / Priority / Hybrid) in real time."
	@echo ""
	@echo "  Launch:"
	@echo "    Terminal 1: make demo-coordinator"
	@echo "    Terminal 2: make demo-web        ->  http://localhost:$(DASHBOARD_PORT)"
	@echo "             or make demo-tkinter    ->  desktop GUI (requires X server)"
	@echo ""
	@echo "================================================================"
	@echo "  B) Safety Board with Mock Sensors  (no PX4, no coordinator)"
	@echo "================================================================"
	@echo ""
	@echo "  What happens:"
	@echo "    A mock sensor publisher cycles through 6 pre-defined scenarios"
	@echo "    every 10 seconds, injecting realistic sensor faults. The safety"
	@echo "    board applies OR-logic veto: any single violation immediately"
	@echo "    blocks the actuator command (output -> 0.0). When all sensors"
	@echo "    return to safe values, the command is cleared (output -> 0.6)."
	@echo ""
	@echo "  Scenarios:"
	@echo "    0 - NOMINAL          all sensors nominal, command passes"
	@echo "    1 - PROXIMITY        obstacle at 0.8m  (threshold 1.5m)  -> VETO"
	@echo "    2 - ATTITUDE         pitch 45 deg      (threshold 30 deg) -> VETO"
	@echo "    3 - BATTERY LOW      10%               (threshold 15%)    -> VETO"
	@echo "    4 - ALTITUDE HIGH    60m               (threshold 50m)    -> VETO"
	@echo "    5 - NOMINAL RECOVERY back to nominal,  command cleared"
	@echo ""
	@echo "  Launch:"
	@echo "    Terminal 1: make demo-safety-board"
	@echo "    Terminal 2: make demo-safety-sensors"
	@echo ""
	@echo "  Monitor:"
	@echo "    ros2 topic echo /actuator_cmd_safe    # 0.6=pass  0.0=vetoed"
	@echo "    ros2 topic echo /safety_status        # 1.0=safe  0.0=unsafe"
	@echo ""
	@echo "================================================================"
	@echo "  C) Full Pipeline Mock  (all layers, no PX4)"
	@echo "================================================================"
	@echo ""
	@echo "  What happens:"
	@echo "    All software layers run together with simulated sensors."
	@echo "    Agents generate tokens -> coordinator approves -> command bridge"
	@echo "    converts approved tokens to actuator commands -> safety board"
	@echo "    independently vetoes if any sensor is in violation. The two"
	@echo "    layers (coordination and safety) are fully decoupled: the safety"
	@echo "    board does not know about tokens and the coordinator does not"
	@echo "    know about sensor readings."
	@echo ""
	@echo "  Launch:"
	@echo "    Terminal 1: make demo-coordinator     # agent -> coordinator -> AuthToken"
	@echo "    Terminal 2: make demo-bridge          # AuthToken -> /actuator_cmd_raw"
	@echo "    Terminal 3: make demo-safety-board    # /actuator_cmd_raw -> /actuator_cmd_safe"
	@echo "    Terminal 4: make demo-safety-sensors  # inject sensor fault scenarios"
	@echo ""
	@echo "  Monitor:"
	@echo "    ros2 topic echo /actuator_cmd_raw     # 0.6 when token approved"
	@echo "    ros2 topic echo /actuator_cmd_safe    # 0.6=cleared  0.0=vetoed"
	@echo ""
	@echo "================================================================"
	@echo "  D) UAV Full Pipeline with Gazebo  (R1 from paper)"
	@echo "================================================================"
	@echo ""
	@echo "  What happens:"
	@echo "    Same as C) but sensor data comes from a real PX4 SITL simulation"
	@echo "    of an x500 quadcopter. The lidar reads actual distances from the"
	@echo "    Gazebo world. Attitude, battery and altitude come directly from"
	@echo "    PX4 uORB topics via the px4_safety_bridge adapter node."
	@echo "    This is the R1 (UAV) scenario described in the paper."
	@echo ""
	@echo "  Prereq: make setup-px4  (already done if you ran setup-all)"
	@echo ""
	@echo "  Launch (in order, wait for each to be ready):"
	@echo "    Terminal 1: make px4-run-uav"
	@echo "                -> wait for pxh>, then arm:"
	@echo "                   param set COM_ARM_WO_GPS 1"
	@echo "                   param set SYS_HAS_MAG 0"
	@echo "                   param set COM_RC_IN_MODE 1"
	@echo "                   param set NAV_RCL_ACT 0"
	@echo "                   param set NAV_DLL_ACT 0"
	@echo "                   param set COM_RCL_EXCEPT 4"
	@echo "                   param save"
	@echo "                   commander takeoff"
	@echo "    Terminal 2: make ros2-agent"
	@echo "    Terminal 3: make ros2-node"
	@echo "    Terminal 4: ros2 run ros_gz_bridge parameter_bridge \\"
	@echo "                  /world/default/model/x500_lidar_front_0/link/lidar_sensor_link/sensor/lidar/scan\\"
	@echo "                  @sensor_msgs/msg/LaserScan[gz.msgs.LaserScan"
	@echo "    Terminal 5: make demo-px4-bridge"
	@echo "    Terminal 6: make demo-safety-board-uav"
	@echo "    Terminal 7: make demo-bridge"
	@echo "    Terminal 8: make demo-coordinator"
	@echo ""
	@echo "================================================================"
	@echo "  E) UGV Full Pipeline with Gazebo  (R2 from paper)"
	@echo "================================================================"
	@echo ""
	@echo "  What happens:"
	@echo "    Same architecture as D) but running on a differential rover."
	@echo "    The safety board is reconfigured for ground operations: altitude"
	@echo "    check is disabled (rover stays on ground), proximity still active"
	@echo "    (frontal lidar detects obstacles). This is the R2 (UGV) scenario"
	@echo "    from the paper where the rover is blocked by a proximity violation."
	@echo ""
	@echo "  Prereq: make setup-rover  (installs custom airframe, run once)"
	@echo ""
	@echo "  Launch (in order):"
	@echo "    Terminal 1: make px4-run-rover"
	@echo "    Terminal 2: make ros2-agent"
	@echo "    Terminal 3: ros2 run ros_gz_bridge parameter_bridge \\"
	@echo "                  /world/rover/model/rover_differential_lidar_0/link/lidar_sensor_link/sensor/lidar/scan\\"
	@echo "                  @sensor_msgs/msg/LaserScan[gz.msgs.LaserScan"
	@echo "    Terminal 4: make demo-px4-bridge-rover"
	@echo "    Terminal 5: make demo-safety-board-rover"
	@echo "    Terminal 6: make demo-bridge"
	@echo "    Terminal 7: make demo-coordinator"
	@echo ""
	@echo "======================================="
	@echo "  4. DEVELOPMENT WORKFLOW"
	@echo "======================================="
	@echo ""
	@echo "  After modifying code:"
	@echo "    $$ make ros2-coordinator-reb   # quick rebuild coordinator"
	@echo "    $$ make ros2-rebuild-ws        # full rebuild"
	@echo ""
	@echo "  Debugging:"
	@echo "    $$ make docker-shell           # enter container"
	@echo "    $$ make diagnose               # full system check"
	@echo "    $$ make ros2-test-topics       # verify PX4 topics"
	@echo ""
	@echo "  For command reference: make help"
	@echo ""
